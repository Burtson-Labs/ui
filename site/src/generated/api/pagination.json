    {
      "name": "paginationRange",
      "kind": "function",
      "description": "The page numbers to show: always the first and last page, `siblings` pages\neither side of the current one, and 'ellipsis' for the gaps.",
      "signatures": [
        "(page: number, pageCount: number, siblings?: number): (number | \"ellipsis\")[]"
      ],
      "type": "(page: number, pageCount: number, siblings?: number) => (number | \"ellipsis\")[]",
      "props": [],
      "inherited": []
    },
    {
      "name": "paginationSummary",
      "kind": "function",
      "description": "\"1–25 of 312\", \"7 of 7\" when everything fits, \"0 of 0\" when empty. Numbers\nuse the locale's grouping (\"1,025\"); pass `locale` to pin it.",
      "signatures": [
        "({ from, to, total }: Pick<PageWindow, \"from\" | \"to\" | \"total\">, locale?: string): string"
      ],
      "type": "({ from, to, total }: Pick<PageWindow, \"from\" | \"to\" | \"total\">, locale?: string) => string",
      "props": [],
      "inherited": []
    },
    {
      "name": "usePagination",
      "kind": "function",
      "description": "Headless paging for a list or table: slices `rows`, clamps the page,\nreturns to page 1 when `resetKey` changes, and optionally remembers the\npage size. Controlled `page` / `pageSize` let an app keep them in the URL.",
      "signatures": [
        "<T>(rows: readonly T[], options?: UsePaginationOptions): UsePaginationResult<T>"
      ],
      "type": "<T>(rows: readonly T[], options?: UsePaginationOptions) => UsePaginationResult<T>",
      "props": [],
      "inherited": []
    },
