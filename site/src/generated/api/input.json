    {
      "name": "fieldWidthClasses",
      "kind": "value",
      "description": "Field widths by what goes in them, on the 4px scale. Every width is full on\na phone (fields stack there); from 640px a field takes the width its\ncontent needs, so a row of them reads as a form rather than a column of\nbars. `full` always fills the row.",
      "signatures": [],
      "type": "{ readonly xs: \"w-full sm:w-24\"; readonly sm: \"w-full sm:w-36\"; readonly md: \"w-full sm:w-48\"; readonly lg: \"w-full sm:max-w-sm\"; readonly full: \"w-full\"; }",
      "props": [],
