{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@burtson-labs/ui": ["./src/index.ts"],
      "@burtson-labs/ui/mui": ["./src/mui/index.ts"]
    }
  },
  "include": [
    "src",
    "site/src",
    "site/vite.config.ts",
    "test",
    "vitest.config.ts",
    "e2e",
    "playwright.config.ts"
  ]
}
