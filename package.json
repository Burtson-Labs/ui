{
  "name": "@burtson-labs/ui",
  "version": "0.8.0",
  "description": "React components for Burtson Labs products: Radix accessibility, Tailwind v4 styling, Burtson Icons. Install the package or copy the source.",
  "license": "MIT",
  "author": {
    "name": "Burtson Labs",
    "email": "team@burtson.ai",
    "url": "https://burtson.ai"
  },
  "homepage": "https://ui.burtson.ai",
  "funding": "https://afsp.org/chapter/missouri",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Burtson-Labs/ui.git"
  },
  "bugs": {
    "url": "https://github.com/Burtson-Labs/ui/issues"
  },
  "keywords": [
    "react",
    "components",
    "design-system",
    "radix-ui",
    "tailwindcss",
    "shadcn",
    "burtson-labs"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mui": {
      "types": "./dist/mui/index.d.ts",
      "import": "./dist/mui/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./theme.css": "./dist/theme.css",
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "dev": "npm run registry && vite --config site/vite.config.ts",
    "build": "node scripts/build.mjs",
    "site": "npm run registry && vite build --config site/vite.config.ts && node --experimental-strip-types --no-warnings scripts/route-pages.mjs",
    "preview": "vite preview --config site/vite.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run site",
    "prepublishOnly": "npm run check",
    "theme": "node --experimental-strip-types --no-warnings scripts/theme.mjs",
    "registry": "node --experimental-strip-types --no-warnings scripts/registry.mjs",
    "og": "npm run site && node scripts/og.mjs"
  },
  "peerDependencies": {
    "@burtson-labs/icons": ">=0.3.0",
    "@emotion/react": ">=11",
    "@mui/material": ">=6",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@emotion/react": {
      "optional": true
    },
    "@mui/material": {
      "optional": true
    }
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "radix-ui": "^1.6.7",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@burtson-labs/frontend-standards": "github:Burtson-Labs/frontend-standards#3d007ff818835a72aaa53087b1f86fedf35bebfe",
    "@burtson-labs/icons": "^0.3.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^9.39.5",
    "@mui/material": "^9.4.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
